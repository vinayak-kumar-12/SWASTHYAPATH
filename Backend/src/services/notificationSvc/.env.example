PORT=5001
NODE_ENV=development

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=SWASTYAPATH-NOTIFICATION

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=swastyapath.events
RABBITMQ_EXCHANGE_TYPE=topic
RABBITMQ_QUEUE=notification-service
RABBITMQ_ROUTING_KEY=notification.email
RABBITMQ_DLX=swastyapath.dlx
RABBITMQ_DLQ=notification-service.dlq
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
RABBITMQ_HEARTBEAT=60
RABBITMQ_RECONNECT_DELAY=5000

# Email Delivery Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
MAIL_FROM=no-reply@swasthyapath.com
MAIL_FROM_NAME=SWASTHYAPATH

# Web Application URLs
FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password

MAX_EMAIL_ATTEMPTS=3
